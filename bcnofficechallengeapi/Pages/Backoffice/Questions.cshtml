@page
@model bcnofficechallengeapi.Pages.Backoffice.QuestionsModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Backoffice - Questions</title>
    <style>
        * { box-sizing: border-box; }
        body { margin:0; font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif; background:#f0f2f5; color:#333; }
        .header { background:#1a1a2e; color:#fff; padding:16px 32px; display:flex; justify-content:space-between; align-items:center; }
        .header h1 { margin:0; font-size:20px; }
        nav { display:flex; gap:20px; }
        nav a { color:#ccc; text-decoration:none; font-size:14px; }
        nav a.active { color:#fff; font-weight:600; }
        .container { max-width:1100px; margin:30px auto; padding:0 20px; }
        .card { background:#fff; border-radius:8px; box-shadow:0 2px 8px rgba(0,0,0,.08); padding:24px; margin-bottom:24px; overflow-x:auto; }
        h2 { margin:0 0 18px; font-size:18px; }
        .question-fields { display:grid; grid-template-columns:180px minmax(280px,1fr) 100px; gap:12px; align-items:end; }
        .option-editor { margin-top:18px; max-width:760px; }
        .option-row { display:grid; grid-template-columns:minmax(240px,1fr) 120px auto; gap:12px; align-items:center; margin-bottom:10px; }
        label { display:block; margin-bottom:5px; font-size:12px; font-weight:700; color:#555; }
        input[type=text], input[type=number], select { width:100%; padding:9px 11px; border:1px solid #ddd; border-radius:6px; font:inherit; }
        .correct { display:flex; align-items:center; gap:7px; min-height:38px; margin:0; font-weight:500; }
        .correct input { width:16px; height:16px; }
        .actions { display:flex; gap:8px; margin-top:16px; }
        button { border:0; border-radius:6px; padding:9px 14px; font-weight:700; cursor:pointer; }
        .primary { background:#4a6cf7; color:#fff; }
        .secondary { background:#e8ecf4; color:#333; }
        .danger { background:#fde8e8; color:#b00020; }
        .save { background:#e8f0fe; color:#315dcc; }
        .option-remove { padding:7px 10px; }
        .alert { padding:12px 16px; margin-bottom:16px; border-radius:6px; background:#fde8e8; color:#b00020; }
        .empty { color:#888; }
        .muted { color:#777; font-size:13px; margin:0 0 12px; }
        .question-card { border-top:1px solid #eee; padding-top:20px; margin-top:20px; }
        @@media (max-width:850px) {
            .header { padding:16px 20px; align-items:flex-start; gap:16px; }
            nav { flex-wrap:wrap; gap:10px 16px; }
            .question-fields, .option-row { grid-template-columns:1fr; }
            .option-row .correct { min-height:0; }
        }
    </style>
</head>
<body>
<div class="header">
    <h1>Backoffice</h1>
    <nav>
        <a href="/Backoffice">Rooms</a>
        <a href="/Backoffice/Questions" class="active">Questions</a>
        <a href="/Backoffice/Curiosities">Curiosities</a>
        <a href="/Backoffice/Users">Users</a>
        <a href="/Backoffice/Login?handler=Logout">Logout</a>
    </nav>
</div>
<main class="container">
    @if (TempData["Error"] is string error)
    {
        <div class="alert">@error</div>
    }

    <section class="card">
        <h2>Add question</h2>
        <p class="muted">Each room can have one question. Mark every correct option.</p>
        @if (Model.Rooms.Count == 0)
        {
            <p class="empty">Create a room before adding a question.</p>
        }
        else
        {
            <form method="post" asp-page-handler="Add" data-option-editor data-prefix="NewQuestion">
                <div class="question-fields">
                    <div><label>Room</label><select name="NewQuestion.SponsorId" required>@foreach (var room in Model.Rooms) { <option value="@room.Id">@room.Name</option> }</select></div>
                    <div><label>Question</label><input type="text" name="NewQuestion.Text" maxlength="1000" required /></div>
                    <div><label>Points</label><input type="number" name="NewQuestion.Points" min="0" value="1" required /></div>
                </div>
                <div class="option-editor">
                    <label>Answer options</label>
                    <div data-options>
                        @for (var optionIndex = 0; optionIndex < Model.NewQuestion.Options.Count; optionIndex++)
                        {
                            <div class="option-row">
                                <input type="text" data-option-field="Text" name="NewQuestion.Options[@optionIndex].Text" maxlength="1000" placeholder="Option @(optionIndex + 1)" required />
                                <label class="correct"><input type="checkbox" data-option-field="IsCorrect" name="NewQuestion.Options[@optionIndex].IsCorrect" value="true" /> Correct</label>
                                <button type="button" class="danger option-remove">Delete</button>
                            </div>
                        }
                    </div>
                    <button type="button" class="secondary add-option">Add option</button>
                </div>
                <div class="actions"><button type="submit" class="primary">Save question</button></div>
            </form>
        }
    </section>

    <section class="card">
        <h2>Existing questions</h2>
        @if (Model.Questions.Count == 0)
        {
            <p class="empty">No questions yet.</p>
        }
        else
        {
            @foreach (var question in Model.Questions)
            {
                <form method="post" asp-page-handler="Update" class="question-card" data-option-editor data-prefix="Form">
                    <input type="hidden" name="Form.Id" value="@question.Id" />
                    <div class="question-fields">
                        <div><label>Room</label><select name="Form.SponsorId" required>@foreach (var room in Model.Rooms) { if (room.Id == question.SponsorId) { <option value="@room.Id" selected>@room.Name</option> } else { <option value="@room.Id">@room.Name</option> } }</select></div>
                        <div><label>Question</label><input type="text" name="Form.Text" value="@question.Text" maxlength="1000" required /></div>
                        <div><label>Points</label><input type="number" name="Form.Points" value="@question.Points" min="0" required /></div>
                    </div>
                    <div class="option-editor">
                        <label>Answer options</label>
                        <div data-options>
                            @for (var optionIndex = 0; optionIndex < question.Options.OrderBy(option => option.SortOrder).ThenBy(option => option.Id).Count(); optionIndex++)
                            {
                                var option = question.Options.OrderBy(item => item.SortOrder).ThenBy(item => item.Id).ElementAt(optionIndex);
                                <div class="option-row">
                                    <input type="text" data-option-field="Text" name="Form.Options[@optionIndex].Text" value="@option.Text" maxlength="1000" required />
                                    <label class="correct"><input type="checkbox" data-option-field="IsCorrect" name="Form.Options[@optionIndex].IsCorrect" value="true" checked="@(option.IsCorrect ? "checked" : null)" /> Correct</label>
                                    <button type="button" class="danger option-remove">Delete</button>
                                </div>
                            }
                        </div>
                        <button type="button" class="secondary add-option">Add option</button>
                    </div>
                    <div class="actions"><button type="submit" class="save">Save</button><button type="submit" class="danger" formaction="?handler=Delete&id=@question.Id" formmethod="post" onclick="return confirm('Delete this question?')">Delete</button></div>
                </form>
            }
        }
    </section>
</main>
<script>
    function reindex(editor) {
        const prefix = editor.dataset.prefix;
        const options = editor.querySelector('[data-options]');
        [...options.querySelectorAll('.option-row')].forEach((row, index) => {
            row.querySelectorAll('[data-option-field]').forEach(input => {
                input.name = `${prefix}.Options[${index}].${input.dataset.optionField}`;
            });
        });
    }

    document.querySelectorAll('[data-option-editor]').forEach(editor => {
        const options = editor.querySelector('[data-options]');
        const template = options.querySelector('.option-row');
        editor.querySelector('.add-option').addEventListener('click', () => {
            const clone = template.cloneNode(true);
            clone.querySelector('input[type="text"]').value = '';
            clone.querySelector('input[type="checkbox"]').checked = false;
            options.appendChild(clone);
            reindex(editor);
        });
        editor.addEventListener('click', event => {
            const button = event.target.closest('.option-remove');
            if (!button) return;
            button.closest('.option-row').remove();
            reindex(editor);
        });
    });
</script>
</body>
</html>
