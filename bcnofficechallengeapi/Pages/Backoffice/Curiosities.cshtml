@page
@model bcnofficechallengeapi.Pages.Backoffice.CuriositiesModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Backoffice - Curiosities</title>
    <style>
        * { box-sizing: border-box; }
        body { margin:0; font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif; background:#f0f2f5; color:#333; }
        .header { background:#1a1a2e; color:#fff; padding:16px 32px; display:flex; justify-content:space-between; align-items:center; }
        .header h1 { margin:0; font-size:20px; }
        nav { display:flex; gap:20px; flex-wrap:wrap; justify-content:flex-end; }
        nav a { color:#ccc; text-decoration:none; font-size:14px; }
        nav a.active { color:#fff; font-weight:600; }
        .container { max-width:1300px; margin:30px auto; padding:0 20px; }
        .card { background:#fff; border-radius:8px; box-shadow:0 2px 8px rgba(0,0,0,.08); padding:24px; margin-bottom:24px; overflow-x:auto; }
        h2 { margin:0 0 18px; font-size:18px; }
        .curiosity-row { display:grid; grid-template-columns:220px minmax(280px,1fr) auto; gap:12px; align-items:end; margin-bottom:12px; }
        label { display:block; margin-bottom:5px; font-size:12px; font-weight:700; color:#555; }
        input[type=text], textarea, select { width:100%; padding:9px 11px; border:1px solid #ddd; border-radius:6px; font:inherit; }
        textarea { min-height:76px; resize:vertical; }
        .actions { display:flex; gap:8px; align-items:center; }
        button { border:0; border-radius:6px; padding:9px 14px; font-weight:700; cursor:pointer; }
        .primary { background:#4a6cf7; color:#fff; }
        .danger { background:#fde8e8; color:#b00020; }
        .save { background:#e8f0fe; color:#315dcc; }
        .alert { padding:12px 16px; margin-bottom:16px; border-radius:6px; background:#fde8e8; color:#b00020; }
        .empty { color:#888; }
        @@media (max-width:850px) {
            .header { gap:16px; align-items:flex-start; }
            .curiosity-row { grid-template-columns:1fr; }
            .actions { justify-content:flex-start; }
        }
    </style>
</head>
<body>
<div class="header">
    <h1>Backoffice</h1>
    <nav>
        <a href="/Backoffice">Rooms</a>
        <a href="/Backoffice/Questions">Questions</a>
        <a href="/Backoffice/Curiosities" class="active">Curiosities</a>
        <a href="/Backoffice/Users">Users</a>
        <a href="/Backoffice/Login?handler=Logout">Logout</a>
    </nav>
</div>
<main class="container">
    @if (TempData["Error"] is string error)
    {
        <div class="alert">@error</div>
    }

    <section class="card">
        <h2>Add curiosity</h2>
        @if (!Model.AvailableRooms.Any())
        {
            <p class="empty">Every room already has a curiosity, or no rooms exist yet.</p>
        }
        else
        {
            <form method="post" asp-page-handler="Add" class="curiosity-row">
                <div>
                    <label for="addRoom">Room</label>
                    <select id="addRoom" name="Form.SponsorId" required>
                        @foreach (var room in Model.AvailableRooms)
                        {
                            <option value="@room.Id">@room.Name</option>
                        }
                    </select>
                </div>
                <div>
                    <label for="addText">Curiosity</label>
                    <textarea id="addText" name="Form.Text" maxlength="1000" required></textarea>
                </div>
                <div class="actions"><button type="submit" class="primary">Add</button></div>
            </form>
        }
    </section>

    <section class="card">
        <h2>Existing curiosities</h2>
        @if (Model.Curiosities.Count == 0)
        {
            <p class="empty">No curiosities yet.</p>
        }
        else
        {
            @foreach (var curiosity in Model.Curiosities)
            {
                <form method="post" asp-page-handler="Update" class="curiosity-row">
                    <input type="hidden" name="Form.Id" value="@curiosity.Id" />
                    <div>
                        <label>Room</label>
                        <select name="Form.SponsorId" required>
                            @foreach (var room in Model.Rooms)
                            {
                                var selected = room.Id == curiosity.SponsorId;
                                var usedByOther = !selected && Model.Curiosities.Any(item => item.Id != curiosity.Id && item.SponsorId == room.Id);
                                if (selected)
                                {
                                    <option value="@room.Id" selected>@room.Name</option>
                                }
                                else if (usedByOther)
                                {
                                    <option value="@room.Id" disabled>@room.Name (already assigned)</option>
                                }
                                else
                                {
                                    <option value="@room.Id">@room.Name</option>
                                }
                            }
                        </select>
                    </div>
                    <div>
                        <label>Curiosity</label>
                        <textarea name="Form.Text" maxlength="1000" required>@curiosity.Text</textarea>
                    </div>
                    <div class="actions">
                        <button type="submit" class="save">Save</button>
                        <button type="submit" class="danger" formaction="?handler=Delete&amp;id=@curiosity.Id" formmethod="post" onclick="return confirm('Delete this curiosity?')">Delete</button>
                    </div>
                </form>
            }
        }
    </section>
</main>
</body>
</html>
